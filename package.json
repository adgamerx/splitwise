{
  "name": "splitwise",
  "version": "1.0.0",
  "description": "Splitwise-like expense sharing backend MVP",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adgamerx/splitwise.git"
  },
  "keywords": [
    "express",
    "sequelize",
    "splitwise",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/adgamerx/splitwise/issues"
  },
  "homepage": "https://github.com/adgamerx/splitwise#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
